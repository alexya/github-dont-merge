{
  "name": "github-dont-merge",
  "version": "0.1.0",
  "private": true,
  "description": "A browser extension project for adding a do-not-merge action to GitHub pull requests.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexya/github-dont-merge.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test",
    "check": "npm run typecheck && npm test",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  }
}
